        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/bell.sh\" UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
